# Copy this file to .env and fill in your local values.
# Never commit the real .env file.

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_root_password
DB_NAME=college_team_finder

# Read-only user for the SQL Explorer (created in db_upgrades.sql)
RO_USER=explorer_ro
RO_PASSWORD=explorer_pass

# JWT auth (signed login tokens)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY_HOURS=24
